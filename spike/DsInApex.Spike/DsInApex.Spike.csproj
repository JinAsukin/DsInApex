<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>DsInApex.Spike</RootNamespace>
    <AssemblyName>DsInApex.Spike</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- ── 部署模式：Unpackaged + Self-contained ── -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <!-- Spike 阶段不做裁剪，避免反射/投影被裁掉导致运行时异常 -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>

    <!-- 明确启用中英双语，验证热切换 -->
    <DefaultLanguage>zh-CN</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- ⚠️ 体积优化的两种方案均已实测否决，元包保持原样不动：
         方案 A（只引 WinUI 子包）→ MSBuild targets 导入链断裂
                （元包不只聚合，还承载 buildTransitive 的 wiring，如 CustomBeforeMicrosoftCommonTargets）
         方案 B（ExcludeAssets 排除 AI/ML/Search/Widgets）→ 无效
                （同一子包被「元包依赖」与「显式引用」两条路径引入，ExcludeAssets 只作用于显式那条）
         真相：体积大头是 self-contained 的 .NET 运行时 + WinUI native 组件，
               AI/ML 组件合计仅约 22MB（9%）。为 9% 冒运行时缺文件的风险不划算。
         结论：不在构建期裁剪，交给 P7 安装器 LZMA 压缩。详见 docs/02-P1开工障碍清除报告.md -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="WinUIEx" Version="2.9.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
