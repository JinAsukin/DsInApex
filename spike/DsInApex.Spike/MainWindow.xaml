<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DsInApex.Spike.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:DsInApex.Spike.Localization"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Ds in Apex · Spike">

    <!-- WinUI 3 的 Window 没有 Resources 属性（与 WPF 不同），托盘菜单直接内联。 -->
    <Grid>

        <!-- ══ S3：系统托盘 ══ -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Ds in Apex · Spike"
                        IconSource="/Assets/app.ico"
                        MenuActivation="RightClick"
                        ContextMenuMode="PopupMenu">
            <!-- 2.4.1 没有 ContextMenu 属性，菜单走 FrameworkElement.ContextFlyout -->
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem loc:Localize.Key="Loc_TrayOpen" Click="OnTrayOpenClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem loc:Localize.Key="Loc_TrayLanguage" Click="OnTrayLanguageClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem loc:Localize.Key="Loc_TrayExit" Click="OnTrayExitClick" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <ScrollViewer Padding="28">
            <StackPanel Spacing="14">

                <!-- ══ 标题 ══ -->
                <StackPanel Spacing="4">
                    <TextBlock loc:Localize.Key="Loc_AppName"
                               FontSize="26" FontWeight="SemiBold" />
                    <TextBlock loc:Localize.Key="Loc_AppSubtitle"
                               FontSize="13" Opacity="0.7" />
                </StackPanel>

                <!-- ══ S2：语言切换 ══ -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock loc:Localize.Key="Loc_Language"
                                       FontWeight="Medium" FontSize="14" />
                            <TextBlock loc:Localize.Key="Loc_LanguageHint"
                                       FontSize="12" Opacity="0.6" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    Spacing="8" VerticalAlignment="Center">
                            <RadioButton x:Name="RadZh" GroupName="LangSelector"
                                         Content="简体中文" Checked="OnLanguageChecked" />
                            <RadioButton x:Name="RadEn" GroupName="LangSelector"
                                         Content="English" Checked="OnLanguageChecked" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══ S2：验证样本 ══ -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="S2 · 语言热切换验证样本"
                                   FontWeight="SemiBold" FontSize="14" />

                        <Grid ColumnSpacing="16" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="TextBlock.Text"
                                       FontFamily="Consolas" FontSize="12" Opacity="0.55" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       loc:Localize.Key="Loc_StatusBadgeStandby" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Button.Content"
                                       FontFamily="Consolas" FontSize="12" Opacity="0.55" />
                            <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"
                                    loc:Localize.Key="Loc_BtnExcludeCurrent" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="CheckBox.Content"
                                       FontFamily="Consolas" FontSize="12" Opacity="0.55" />
                            <CheckBox Grid.Row="2" Grid.Column="1"
                                      loc:Localize.Key="Loc_EnableDetection" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="RadioButton.Content"
                                       FontFamily="Consolas" FontSize="12" Opacity="0.55" />
                            <RadioButton Grid.Row="3" Grid.Column="1"
                                         loc:Localize.Key="Loc_TabHaptics" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="TextBox.PlaceholderText"
                                       FontFamily="Consolas" FontSize="12" Opacity="0.55" />
                            <TextBox Grid.Row="4" Grid.Column="1" MaxWidth="320"
                                     HorizontalAlignment="Left"
                                     loc:Localize.Key="Loc_SearchPlaceholder" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="ComboBoxItem.Content"
                                       FontFamily="Consolas" FontSize="12" Opacity="0.55" />
                            <ComboBox Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left"
                                      SelectedIndex="0">
                                <ComboBoxItem loc:Localize.Key="Loc_TabAll" />
                                <ComboBoxItem loc:Localize.Key="Loc_TabTriggers" />
                                <ComboBoxItem loc:Localize.Key="Loc_TabExcluded" />
                            </ComboBox>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Format(带参数)"
                                       FontFamily="Consolas" FontSize="12" Opacity="0.55" />
                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="FormattedSampleText"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ══ S4：引擎调用与解析 ══ -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="S4 · C++ 引擎调用与输出解析"
                                   FontWeight="SemiBold" FontSize="14" />
                        <TextBlock x:Name="EnginePathText" FontFamily="Consolas"
                                   FontSize="11" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnRunList" Content="运行 list"
                                    Click="OnRunListClick" />
                            <Button x:Name="BtnRunIdentify" Content="运行 identify"
                                    Click="OnRunIdentifyClick" />
                            <Button x:Name="BtnRunDiagnose" Content="运行 diagnose --json"
                                    Click="OnRunDiagnoseClick" />
                        </StackPanel>
                        <TextBlock x:Name="EngineResultText" FontFamily="Consolas"
                                   FontSize="11" TextWrapping="Wrap"
                                   MaxHeight="260" />
                    </StackPanel>
                </Border>

                <!-- ══ S6：文件选择器 ══ -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="S6 · FilePicker（unpackaged 需 InitializeWithWindow）"
                                   FontWeight="SemiBold" FontSize="14" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnPickFile" Content="选择文件..." Click="OnPickFileClick" />
                            <Button x:Name="BtnPickFolder" Content="选择文件夹..." Click="OnPickFolderClick" />
                        </StackPanel>
                        <TextBlock x:Name="PickerResultText" FontFamily="Consolas"
                                   FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ══ S1/S5：环境自检 ══ -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20,16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="运行环境自检" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock x:Name="EnvInfoText" FontFamily="Consolas"
                                   FontSize="11" TextWrapping="Wrap" />
                        <TextBlock x:Name="RefreshStatsText" FontFamily="Consolas"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock x:Name="TrayInfoText" FontFamily="Consolas"
                                   FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Spike 代码为一次性验证产物，验证完成后归档。关闭窗口不会退出程序，请从托盘菜单退出。"
                           FontSize="12" Opacity="0.5" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
