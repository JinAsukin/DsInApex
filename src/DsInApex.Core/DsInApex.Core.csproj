<Project Sdk="Microsoft.NET.Sdk">

  <!-- ═══════════════════════════════════════════════════════════════════
       Ds in Apex · Core 层（业务逻辑，无 UI 依赖）
       迁移来源：上游 ApexSenseBridgeTray/Services/* + Common/AppLog.cs
       约束：不得引用 WinUI / WPF —— 保证可在无 UI 环境下单元测试
       ═══════════════════════════════════════════════════════════════════ -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>DsInApex.Core</RootNamespace>
    <AssemblyName>DsInApex.Core</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWinUI>false</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

</Project>
