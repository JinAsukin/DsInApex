<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DsInApex.App.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:DsInApex.App.Localization"
    xmlns:vm="using:DsInApex.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- ══════════════════════════════════════════════════════════════════
         P5 · 诊断面板页
         上游是一份 1127 行的 PowerShell 脚本（还得先能跑 Add-Type）。
         这里把它变成「填几个选项 → 点一下 → 拿到一个 ZIP」。

         收集全程只读：不装驱动、不改手柄设置、不写任何 HID 报文。
         ══════════════════════════════════════════════════════════════════ -->

    <Grid Padding="24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══ 页头 ══ -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock loc:Localize.Key="Loc_NavDiagnostics" FontSize="24" FontWeight="SemiBold" />
            <TextBlock loc:Localize.Key="Loc_PageDiagnosticsDesc" FontSize="13" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ══ 选项 + 操作 ══ -->
        <Border Grid.Row="1" CornerRadius="8" Padding="16,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <StackPanel Spacing="12">

                <!-- 输出目录 -->
                <StackPanel Spacing="4">
                    <TextBlock loc:Localize.Key="Loc_DiagOutputDir" FontSize="12" Opacity="0.75" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{x:Bind ViewModel.OutputDirectory, Mode=TwoWay}"
                                 IsEnabled="{x:Bind ViewModel.CanCollect, Mode=OneWay}" />
                        <Button Grid.Column="1"
                                loc:Localize.Key="Loc_DiagOpenDir"
                                Command="{x:Bind ViewModel.OpenOutputDirectoryCommand}" />
                    </Grid>
                </StackPanel>

                <!-- 采样秒数 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               loc:Localize.Key="Loc_DiagSampleSeconds" FontSize="12" />
                    <Slider Grid.Column="1" VerticalAlignment="Center"
                            Minimum="1" Maximum="30" StepFrequency="1"
                            IsEnabled="{x:Bind ViewModel.CanCollect, Mode=OneWay}"
                            Value="{x:Bind ViewModel.InputSampleSeconds, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" MinWidth="28"
                               Text="{x:Bind ViewModel.InputSampleSeconds, Mode=OneWay}" FontSize="12" />
                </Grid>

                <!-- 开关项 -->
                <StackPanel Spacing="6">
                    <CheckBox loc:Localize.Key="Loc_DiagSkipSample"
                              IsEnabled="{x:Bind ViewModel.CanCollect, Mode=OneWay}"
                              IsChecked="{x:Bind ViewModel.SkipInputSample, Mode=TwoWay}" />
                    <CheckBox loc:Localize.Key="Loc_DiagKeepWorking"
                              IsEnabled="{x:Bind ViewModel.CanCollect, Mode=OneWay}"
                              IsChecked="{x:Bind ViewModel.KeepWorkingDirectory, Mode=TwoWay}" />
                </StackPanel>

                <TextBlock loc:Localize.Key="Loc_DiagSafetyNote"
                           FontSize="11" Opacity="0.6" TextWrapping="Wrap" />

                <!-- 操作按钮 + 进度 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource AccentButtonStyle}"
                            loc:Localize.Key="Loc_DiagBtnCollect"
                            IsEnabled="{x:Bind ViewModel.CanCollect, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CollectCommand}" />

                    <Button Grid.Column="1"
                            loc:Localize.Key="Loc_DiagBtnCancel"
                            IsEnabled="{x:Bind ViewModel.IsCollecting, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CancelCommand}" />

                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                               Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                               FontSize="12" Opacity="0.7" TextWrapping="Wrap" />

                    <ProgressRing Grid.Column="3" VerticalAlignment="Center"
                                  Width="20" Height="20"
                                  IsActive="{x:Bind ViewModel.IsCollecting, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsCollecting, Mode=OneWay}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ══ 结果区 ══ -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Padding="0,0,4,0">

                <!-- 收集结果摘要 -->
                <Border CornerRadius="8" Padding="16,14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.ResultHeadline, Mode=OneWay}"
                                   FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.ResultDetail, Mode=OneWay}"
                                   FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />

                        <StackPanel Orientation="Horizontal" Spacing="10"
                                    Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}">
                            <Button loc:Localize.Key="Loc_DiagRevealArchive"
                                    Click="OnRevealArchiveClick" />
                        </StackPanel>

                        <!-- 7 步状态 -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Steps, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.HasSteps, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiagnosticStepItem">
                                    <Grid ColumnSpacing="10" Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" FontSize="12"
                                                  Glyph="{x:Bind Glyph}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Label}"
                                                   FontSize="12" FontWeight="SemiBold" MinWidth="90" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Detail}"
                                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 警告 -->
                        <InfoBar IsOpen="{x:Bind ViewModel.HasWarnings, Mode=OneWay}"
                                 Severity="Warning"
                                 IsClosable="False"
                                 loc:Localize.Key="Loc_DiagWarningsTitle" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Warnings, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,2"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 实时日志 -->
                <Border CornerRadius="8" Padding="16,14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <TextBlock loc:Localize.Key="Loc_DiagLog"
                                   FontSize="15" FontWeight="SemiBold" />
                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.LogLines, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" FontFamily="Consolas"
                                                   FontSize="11" TextWrapping="NoWrap"
                                                   IsTextSelectionEnabled="True" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
