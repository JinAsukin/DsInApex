<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DsInApex.App.Views.HardwareTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:DsInApex.App.Localization"
    xmlns:vm="using:DsInApex.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- ══════════════════════════════════════════════════════════════════
         P5 · 硬件测试页
         把引擎的 19 个子命令收进界面，并按「影响等级」分成三段：

           只读区  —— 随时可跑（含自检）
           测试区  —— 会真实驱动扳机 / 马达，会话运行期间禁用
           应急区  —— 会改变全局状态，必须二次确认

         ⚠️ 三段的顺序与配色是刻意设计的：风险越往下越高，
            用户不该在没看清标题的情况下点下去。
         ══════════════════════════════════════════════════════════════════ -->

    <Grid Padding="24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══ 页头 ══ -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock loc:Localize.Key="Loc_NavHardwareTest" FontSize="24" FontWeight="SemiBold" />
            <TextBlock loc:Localize.Key="Loc_PageHardwareDesc" FontSize="13" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ══ 状态条：引擎 / 会话 / 当前设备 ══ -->
        <Border Grid.Row="1" CornerRadius="8" Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="{x:Bind ViewModel.DeviceHeadline, Mode=OneWay}"
                               FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.DeviceDetail, Mode=OneWay}"
                               FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.StatusLine, Mode=OneWay}"
                               FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                </StackPanel>

                <ProgressRing Grid.Column="1" VerticalAlignment="Center"
                              Width="20" Height="20"
                              IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                <Button Grid.Column="2" VerticalAlignment="Center"
                        loc:Localize.Key="Loc_HwRefresh"
                        Command="{x:Bind ViewModel.RefreshDeviceCommand}" />
            </Grid>
        </Border>

        <!-- ══ 主体 ══ -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Padding="0,0,4,0">

                <!-- ─────────── 只读区 ─────────── -->
                <Border CornerRadius="8" Padding="16,14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock loc:Localize.Key="Loc_HwSectionReadOnly"
                                   FontSize="15" FontWeight="SemiBold" />
                        <TextBlock loc:Localize.Key="Loc_HwSectionReadOnlyHint"
                                   FontSize="12" Opacity="0.65" TextWrapping="Wrap" />

                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch"
                                    loc:Localize.Key="Loc_HwBtnDiagnose"
                                    IsEnabled="{x:Bind ViewModel.CanRunReadOnly, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.DiagnoseCommand}" />
                            <Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                    loc:Localize.Key="Loc_HwBtnXInput"
                                    IsEnabled="{x:Bind ViewModel.CanRunReadOnly, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.XInputStatusCommand}" />
                            <Button Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch"
                                    loc:Localize.Key="Loc_HwBtnDryRun"
                                    IsEnabled="{x:Bind ViewModel.CanRunReadOnly, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.DryRunCommand}" />
                            <!-- 虚拟 DS5 测试：它不碰 APEX 硬件，但会创建虚拟手柄，
                                 与活动会话会争用 VIIPER 后端 —— 因此跟随硬件测试的可用条件。 -->
                            <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                    loc:Localize.Key="Loc_HwBtnVirtualDs"
                                    IsEnabled="{x:Bind ViewModel.CanRunHardwareTest, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.VirtualDsCommand}" />
                        </Grid>

                        <!-- 设备清单（list 结果；多设备时才有意义） -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HardwareDeviceItem">
                                    <Border CornerRadius="6" Padding="12,8" Margin="0,4,0,0"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind DisplayName}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind VidPidText}" FontSize="11" Opacity="0.7" />
                                            <TextBlock Text="{x:Bind UsageText}" FontSize="11" Opacity="0.6" />
                                            <TextBlock Text="{x:Bind ReportsText}" FontSize="11" Opacity="0.6" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ─────────── 输入监视 ─────────── -->
                <Border CornerRadius="8" Padding="16,14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock loc:Localize.Key="Loc_HwSectionInput"
                                   FontSize="15" FontWeight="SemiBold" />
                        <TextBlock loc:Localize.Key="Loc_HwSectionInputHint"
                                   FontSize="12" Opacity="0.65" TextWrapping="Wrap" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       loc:Localize.Key="Loc_HwSampleSeconds" FontSize="12" />
                            <Slider Grid.Column="1" VerticalAlignment="Center"
                                    Minimum="1" Maximum="60" StepFrequency="1"
                                    Value="{x:Bind ViewModel.InputSecondsValue, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" MinWidth="28"
                                       Text="{x:Bind ViewModel.InputSecondsValue, Mode=OneWay}" FontSize="12" />
                            <Button Grid.Column="3" VerticalAlignment="Center"
                                    loc:Localize.Key="Loc_HwBtnInputMonitor"
                                    IsEnabled="{x:Bind ViewModel.CanRunHardwareTest, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.InputMonitorCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─────────── 硬件测试区（会真实驱动手柄） ─────────── -->
                <Border CornerRadius="8" Padding="16,14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock loc:Localize.Key="Loc_HwSectionTest"
                                   FontSize="15" FontWeight="SemiBold" />
                        <TextBlock loc:Localize.Key="Loc_HwSectionTestHint"
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" />

                        <!-- 会话运行期间禁用并说明原因，而不是让按钮静默失败 -->
                        <InfoBar IsOpen="{x:Bind ViewModel.SessionActive, Mode=OneWay}"
                                 Severity="Informational"
                                 IsClosable="False"
                                 loc:Localize.Key="Loc_HwSessionBlocksTest" />

                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 第 0 行：扳机强度档位（对应引擎的 level 参数 1..4）。
                                 ⚠️ 必须给用户：默认 level 2 很轻，
                                 「某一侧坏了」和「那一侧太轻没感觉」根本分不开。 -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                        Orientation="Horizontal" Spacing="8">
                                <TextBlock loc:Localize.Key="Loc_HwTriggerLevel"
                                           VerticalAlignment="Center" FontSize="12" />
                                <ComboBox MinWidth="130"
                                          SelectedIndex="{x:Bind ViewModel.TriggerLevelIndex, Mode=TwoWay}">
                                    <ComboBoxItem loc:Localize.Key="Loc_TriggerLevel1" />
                                    <ComboBoxItem loc:Localize.Key="Loc_TriggerLevel2" />
                                    <ComboBoxItem loc:Localize.Key="Loc_TriggerLevel3" />
                                    <ComboBoxItem loc:Localize.Key="Loc_TriggerLevel4" />
                                </ComboBox>
                            </StackPanel>

                            <!-- 第 1 行：分侧扳机测试。
                                 ⚠️ 这里刻意排成「左 / 右 / 双侧」三格，而不是一个按钮 ——
                                 旧版唯一的 test-rt 固定驱动右扳机，
                                 导致「LT 好还是 RT 坏」在界面上根本无法自证。 -->
                            <Button Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch"
                                    loc:Localize.Key="Loc_HwBtnTriggerLt"
                                    IsEnabled="{x:Bind ViewModel.CanRunHardwareTest, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.TestTriggerLeftCommand}" />
                            <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                                    loc:Localize.Key="Loc_HwBtnTriggerRt"
                                    IsEnabled="{x:Bind ViewModel.CanRunHardwareTest, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.TestTriggerRightCommand}" />
                            <Button Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch"
                                    loc:Localize.Key="Loc_HwBtnTriggerBoth"
                                    IsEnabled="{x:Bind ViewModel.CanRunHardwareTest, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.TestTriggerBothCommand}" />

                            <Button Grid.Row="2" Grid.Column="0" HorizontalAlignment="Stretch"
                                    loc:Localize.Key="Loc_HwBtnTestRumble"
                                    IsEnabled="{x:Bind ViewModel.CanRunHardwareTest, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.TestRumbleCommand}" />

                            <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                                    loc:Localize.Key="Loc_HwBtnPortTest"
                                    IsEnabled="{x:Bind ViewModel.CanRunHardwareTest, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.PortTestCommand}" />

                            <!-- 配置档切换：实测仅 APEX 5 支持，APEX 4 上直接隐藏 -->
                            <StackPanel Grid.Row="2" Grid.Column="2" Spacing="6"
                                        Visibility="{x:Bind ViewModel.SupportsProfileSwitch, Mode=OneWay}">
                                <ComboBox HorizontalAlignment="Stretch"
                                          SelectedIndex="{x:Bind ViewModel.ProfileTargetIndex, Mode=TwoWay}">
                                    <ComboBoxItem loc:Localize.Key="Loc_ApexProfile1" />
                                    <ComboBoxItem loc:Localize.Key="Loc_ApexProfile2" />
                                    <ComboBoxItem loc:Localize.Key="Loc_ApexProfile3" />
                                    <ComboBoxItem loc:Localize.Key="Loc_ApexProfile4" />
                                </ComboBox>
                                <Button HorizontalAlignment="Stretch"
                                        loc:Localize.Key="Loc_HwBtnProfileSwitch"
                                        IsEnabled="{x:Bind ViewModel.CanRunHardwareTest, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.TestProfileSwitchCommand}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─────────── 应急操作区 ─────────── -->
                <Border CornerRadius="8" Padding="16,14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock loc:Localize.Key="Loc_HwSectionEmergency"
                                   FontSize="15" FontWeight="SemiBold" />
                        <TextBlock loc:Localize.Key="Loc_HwSectionEmergencyHint"
                                   FontSize="12" Opacity="0.7" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button loc:Localize.Key="Loc_HwBtnClear"
                                    Command="{x:Bind ViewModel.ClearEffectsCommand}" />
                            <Button loc:Localize.Key="Loc_HwBtnStopSessions"
                                    Click="OnStopSessionsClick" />
                            <Button loc:Localize.Key="Loc_HwBtnRestoreVisibility"
                                    Click="OnRestoreVisibilityClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ─────────── 结果面板 ─────────── -->
                <Border CornerRadius="8" Padding="16,14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.ResultTitle, Mode=OneWay}"
                                   FontSize="15" FontWeight="SemiBold" />

                        <!-- 解析失败：明确告诉用户已降级，而不是让空表格冒充"无数据" -->
                        <InfoBar IsOpen="{x:Bind ViewModel.HasParseWarning, Mode=OneWay}"
                                 Severity="Warning"
                                 IsClosable="False"
                                 Message="{x:Bind ViewModel.ParseWarning, Mode=OneWay}" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.ResultLines, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HardwareResultLine">
                                    <Grid ColumnSpacing="12" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Label}"
                                                   FontSize="12" Opacity="0.65"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Value}"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 原始输出：永远保留，供解析失败时对照。
                             ⚠️ 这里必须用 loc:Localize.Header 而不是 Key ——
                                Expander 继承自 ContentControl，用 Key 会被智能路由
                                判定为「设置 Content」，把那棵 ScrollViewer 子树整个换成字符串。 -->
                        <Expander HorizontalAlignment="Stretch"
                                  loc:Localize.Header="Loc_HwRawOutput">
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollMode="Enabled"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBlock Text="{x:Bind ViewModel.RawOutput, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="11"
                                           TextWrapping="NoWrap"
                                           IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </Expander>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
