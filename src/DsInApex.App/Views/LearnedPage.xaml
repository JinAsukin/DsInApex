<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DsInApex.App.Views.LearnedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:DsInApex.App.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,24">
        <StackPanel Spacing="10">
            <TextBlock loc:Localize.Key="Loc_NavLearned" FontSize="24" FontWeight="SemiBold" />
            <TextBlock loc:Localize.Key="Loc_PageLearnedDesc" FontSize="13" Opacity="0.7" TextWrapping="Wrap" />
            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8" />
            <TextBlock loc:Localize.Key="Loc_PlaceholderPending" FontSize="12" Opacity="0.5" />
        </StackPanel>
    </Grid>
</Page>
