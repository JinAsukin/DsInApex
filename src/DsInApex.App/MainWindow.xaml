<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DsInApex.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:DsInApex.App.Localization"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Ds in Apex">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <!-- ⚠️ XAML 规则：属性元素（RowDefinitions）必须出现在子元素之前 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══ 系统托盘（P2 验证项：与 NavigationView 共存；P6 扩展为完整后台控制面） ══
             TaskbarIcon 无可视内容，放在 Grid 里不影响布局。
             菜单走 ContextFlyout（H.NotifyIcon 2.4.1 无 ContextMenu 属性）。
             文案由 loc:Localize.Key 负责热切换；含变量/需按状态二选一的项（状态行、恢复项）
             不走 loc（它没有占位符能力），由 UpdateTrayState() 手工刷。 -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Ds in Apex"
                        IconSource="/Assets/AppIcon.ico"
                        MenuActivation="RightClick"
                        ContextMenuMode="PopupMenu">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout Opening="OnTrayMenuOpening">
                    <!-- 状态行：禁用态，只读展示 -->
                    <MenuFlyoutItem x:Name="TrayStatusItem" IsEnabled="False" FontWeight="SemiBold" />
                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem x:Name="TrayOpenItem" loc:Localize.Key="Loc_TrayOpen"
                                    Click="OnTrayOpenClick" FontWeight="SemiBold" />
                    <MenuFlyoutItem x:Name="TrayStartItem" loc:Localize.Key="Loc_BtnStartBridge"
                                    Click="OnTrayStartBridgeClick" />
                    <MenuFlyoutItem x:Name="TrayStopItem" loc:Localize.Key="Loc_BtnStopBridge"
                                    Click="OnTrayStopBridgeClick" />
                    <MenuFlyoutSeparator />

                    <ToggleMenuFlyoutItem x:Name="TrayAutoDetectItem" loc:Localize.Key="Loc_TrayAutoDetect"
                                          Click="OnTrayAutoDetectClick" />
                    <ToggleMenuFlyoutItem x:Name="TrayAutoStartItem" loc:Localize.Key="Loc_TrayStartWithWindows"
                                          Click="OnTrayAutoStartClick" />
                    <MenuFlyoutSeparator />

                    <!-- P6：把 P5 的两个只读页也挂到托盘，省得为了看一眼诊断先开窗口 -->
                    <MenuFlyoutItem loc:Localize.Key="Loc_TrayHardwareTest" Click="OnTrayHardwareTestClick" />
                    <MenuFlyoutItem loc:Localize.Key="Loc_TrayDiagnostics" Click="OnTrayDiagnosticsClick" />
                    <!-- 仅当发现「上次会话异常遗留」时出现 -->
                    <MenuFlyoutItem x:Name="TrayRecoveryItem" Click="OnTrayRecoveryClick"
                                    Visibility="Collapsed" />
                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem loc:Localize.Key="Loc_TrayCheckUpdates" Click="OnTrayCheckUpdatesClick" />
                    <MenuFlyoutSeparator />

                    <!-- 语言：两个平铺的互斥项。刻意不用 MenuFlyoutSubItem ——
                         子菜单在 H.NotifyIcon 的自绘弹窗里层数更深，
                         而语言本来就只有两个选项，平铺更快更清楚。 -->
                    <RadioMenuFlyoutItem x:Name="TrayLangZhItem" Text="简体中文" GroupName="TrayLanguage"
                                         Click="OnTrayLanguageClick" />
                    <RadioMenuFlyoutItem x:Name="TrayLangEnItem" Text="English" GroupName="TrayLanguage"
                                         Click="OnTrayLanguageClick" />
                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem loc:Localize.Key="Loc_TrayPortableInfo" Click="OnTrayPortableInfoClick" />
                    <MenuFlyoutItem loc:Localize.Key="Loc_TrayExit" Click="OnTrayExitClick" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>


        <!-- ══ 标题栏 ══
             品牌名不做本地化，直接写死；窗口标题同时给任务栏用。 -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="Ds in Apex"
            BackRequested="OnTitleBarBackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnTitleBarPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- ══ 导航壳 ══
             8 个页面在这里手工声明而不是从 ViewModel 生成：
             P1 阶段页面集固定，手写能直接使用 loc:Localize.Key 做本地化，
             也比 DataTemplate + x:Bind 到附加属性更少踩坑。
             Tag 必须与 MainWindowViewModel.NavigationItems 的 Tag 一致。 -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            SelectionChanged="OnNavigationSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="dashboard" loc:Localize.Key="Loc_NavDashboard">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="gamelib" loc:Localize.Key="Loc_NavGameLibrary">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7FC;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="learned" loc:Localize.Key="Loc_NavLearned">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE82D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Tag="drivers" loc:Localize.Key="Loc_NavDrivers">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="hardware" loc:Localize.Key="Loc_NavHardwareTest">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="diagnostics" loc:Localize.Key="Loc_NavDiagnostics">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Tag="settings" loc:Localize.Key="Loc_NavSettings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="about" loc:Localize.Key="Loc_NavAbout">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- ══ 语言切换（P1 验收项：中英热切换） ══ -->
            <NavigationView.PaneFooter>
                <StackPanel Margin="4,8,4,12" Spacing="2">
                    <TextBlock loc:Localize.Key="Loc_Language"
                               FontSize="12" Opacity="0.6" Margin="12,0,0,4" />
                    <RadioButton x:Name="RadZh" GroupName="LangSelector"
                                 Content="简体中文" Checked="OnLanguageChecked" />
                    <RadioButton x:Name="RadEn" GroupName="LangSelector"
                                 Content="English" Checked="OnLanguageChecked" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>
