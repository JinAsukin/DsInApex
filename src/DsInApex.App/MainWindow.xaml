<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DsInApex.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:DsInApex.App.Localization"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Ds in Apex">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <!-- ⚠️ XAML 规则：属性元素（RowDefinitions）必须出现在子元素之前 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══ 系统托盘（P2 验证项：与 NavigationView 共存） ══
             TaskbarIcon 无可视内容，放在 Grid 里不影响布局。
             菜单走 ContextFlyout（H.NotifyIcon 2.4.1 无 ContextMenu 属性）。 -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Ds in Apex"
                        IconSource="/Assets/AppIcon.ico"
                        MenuActivation="RightClick"
                        ContextMenuMode="PopupMenu">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem loc:Localize.Key="Loc_TrayOpen" Click="OnTrayOpenClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem loc:Localize.Key="Loc_TrayLanguage" Click="OnTrayLanguageClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem loc:Localize.Key="Loc_TrayExit" Click="OnTrayExitClick" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>


        <!-- ══ 标题栏 ══
             品牌名不做本地化，直接写死；窗口标题同时给任务栏用。 -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="Ds in Apex"
            BackRequested="OnTitleBarBackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnTitleBarPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- ══ 导航壳 ══
             8 个页面在这里手工声明而不是从 ViewModel 生成：
             P1 阶段页面集固定，手写能直接使用 loc:Localize.Key 做本地化，
             也比 DataTemplate + x:Bind 到附加属性更少踩坑。
             Tag 必须与 MainWindowViewModel.NavigationItems 的 Tag 一致。 -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            SelectionChanged="OnNavigationSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="dashboard" loc:Localize.Key="Loc_NavDashboard">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="gamelib" loc:Localize.Key="Loc_NavGameLibrary">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7FC;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="learned" loc:Localize.Key="Loc_NavLearned">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE82D;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Tag="drivers" loc:Localize.Key="Loc_NavDrivers">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="hardware" loc:Localize.Key="Loc_NavHardwareTest">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="diagnostics" loc:Localize.Key="Loc_NavDiagnostics">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Tag="settings" loc:Localize.Key="Loc_NavSettings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="about" loc:Localize.Key="Loc_NavAbout">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- ══ 语言切换（P1 验收项：中英热切换） ══ -->
            <NavigationView.PaneFooter>
                <StackPanel Margin="4,8,4,12" Spacing="2">
                    <TextBlock loc:Localize.Key="Loc_Language"
                               FontSize="12" Opacity="0.6" Margin="12,0,0,4" />
                    <RadioButton x:Name="RadZh" GroupName="LangSelector"
                                 Content="简体中文" Checked="OnLanguageChecked" />
                    <RadioButton x:Name="RadEn" GroupName="LangSelector"
                                 Content="English" Checked="OnLanguageChecked" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>
