<UserControl x:Class="DsInApex.Playnite.DsInApexSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="760">
    <!--
      注意：这里是 WPF（Playnite 宿主是 WPF），DockPanel / DataGrid 都可用 ——
      与主程序 WinUI 3 那套「DockPanel 不存在」的约束完全无关，不要照着 docs/01 坑点改。
      所有文案走 {DynamicResource LOCDsInApex_*}：键由 Loc.Initialize 合并进 Application.Resources。
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,16"
                       TextWrapping="Wrap"
                       Text="{DynamicResource LOCDsInApex_SettingsIntro}" />

            <!-- ── 部署位置 ── -->
            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4,12,10"
                       VerticalAlignment="Center"
                       Text="{DynamicResource LOCDsInApex_SettingsInstallation}" />
            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
                <TextBlock FontWeight="SemiBold" Text="{Binding InstallationStatus}" />
                <TextBlock Margin="0,3,0,0" Opacity="0.7" TextWrapping="Wrap"
                           Text="{Binding InstalledExecutablePath}" />
                <DockPanel Margin="0,8,0,0" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,4"
                            Content="{DynamicResource LOCDsInApex_SettingsDetectAutomatically}"
                            Command="{Binding UseAutomaticInstallationCommand}" />
                    <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,4"
                            Content="{DynamicResource LOCDsInApex_SettingsBrowse}"
                            Command="{Binding BrowseForExecutableCommand}" />
                    <TextBox VerticalContentAlignment="Center"
                             Text="{Binding ConfiguredDeployPath, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{DynamicResource LOCDsInApex_SettingsPathTooltip}" />
                </DockPanel>
            </StackPanel>

            <!-- ── 更新 ── -->
            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4,12,14"
                       VerticalAlignment="Top"
                       Text="{DynamicResource LOCDsInApex_SettingsUpdates}" />
            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,14">
                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.8"
                               Text="{DynamicResource LOCDsInApex_SettingsCurrentVersion}" />
                    <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="SemiBold"
                               Text="{Binding CurrentVersionDisplay}" />
                    <Button Padding="10,4"
                            Content="{DynamicResource LOCDsInApex_SettingsCheckForUpdates}"
                            Command="{Binding CheckForUpdatesCommand}"
                            IsEnabled="{Binding IsNotCheckingForUpdate}" />
                </DockPanel>

                <CheckBox Margin="0,4,0,6"
                          IsChecked="{Binding Settings.AutoCheckUpdates}"
                          Content="{DynamicResource LOCDsInApex_SettingsAutoCheckUpdates}" />

                <TextBlock Text="{Binding UpdateCheckStatus}" TextWrapping="Wrap" Margin="0,4,0,6"
                           FontStyle="Italic" Opacity="0.85" />

                <StackPanel Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                            Margin="0,4,0,0">
                    <Button Padding="12,6" FontWeight="SemiBold" HorizontalAlignment="Left"
                            Margin="0,0,0,3"
                            Content="{DynamicResource LOCDsInApex_SettingsOpenReleasePage}"
                            Command="{Binding OpenReleasePageCommand}" />
                    <TextBlock Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                               Text="{DynamicResource LOCDsInApex_SettingsUpdateHint}" />
                </StackPanel>
            </StackPanel>

            <!-- ── 自动配置档 ── -->
            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4,12,10"
                       VerticalAlignment="Center"
                       Text="{DynamicResource LOCDsInApex_SettingsAutomaticProfiles}" />
            <CheckBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,10"
                      IsChecked="{Binding Settings.EnableAutomaticProfiles}"
                      Content="{DynamicResource LOCDsInApex_SettingsDetectProfilesAtLaunch}" />

            <!-- ── 震动 ── -->
            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,4,12,10"
                       VerticalAlignment="Center"
                       Text="{DynamicResource LOCDsInApex_SettingsRumble}" />
            <CheckBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,10"
                      IsChecked="{Binding Settings.EnableRumble}"
                      Content="{DynamicResource LOCDsInApex_SettingsEnableRumble}" />

            <!-- ── 触觉阈值 ── -->
            <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,4,12,10"
                       VerticalAlignment="Center"
                       Text="{DynamicResource LOCDsInApex_SettingsHapticThreshold}" />
            <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10"
                     MaxWidth="100" HorizontalAlignment="Left"
                     Text="{Binding Settings.HapticThresholdPercent, UpdateSourceTrigger=PropertyChanged}" />

            <!-- ── 初始化超时 ── -->
            <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,4,12,10"
                       VerticalAlignment="Center"
                       Text="{DynamicResource LOCDsInApex_SettingsInitTimeout}" />
            <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10"
                     MaxWidth="100" HorizontalAlignment="Left"
                     Text="{Binding Settings.InitializationTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />

            <!-- ── APEX 4 陀螺仪（引擎 1.0.0-beta.10，上游 issue #10） ──
                 区间 25–400 是引擎硬契约：越界会被 C++ 参数解析器拒绝、整个桥接起不来。
                 文本框这里只做提示，真正的夹紧在 DsInApexPlugin.BuildBridgeArguments。 -->
            <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Margin="0,4,0,8">
                <TextBlock FontWeight="SemiBold"
                           Text="{DynamicResource LOCDsInApex_SettingsGyro}" />
                <TextBlock Margin="0,4,0,0" Opacity="0.75" TextWrapping="Wrap"
                           Text="{DynamicResource LOCDsInApex_SettingsGyroHint}" />
            </StackPanel>

            <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,4,12,10"
                       VerticalAlignment="Center"
                       Text="{DynamicResource LOCDsInApex_SettingsGyroStrength}" />
            <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10"
                     MaxWidth="100" HorizontalAlignment="Left"
                     ToolTip="{DynamicResource LOCDsInApex_SettingsGyroRangeTooltip}"
                     Text="{Binding Settings.Apex4GyroStrengthPercent, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="9" Grid.Column="0" Margin="0,4,12,10"
                       VerticalAlignment="Center"
                       Text="{DynamicResource LOCDsInApex_SettingsGyroYawStrength}" />
            <TextBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10"
                     MaxWidth="100" HorizontalAlignment="Left"
                     ToolTip="{DynamicResource LOCDsInApex_SettingsGyroRangeTooltip}"
                     Text="{Binding Settings.Apex4GyroYawStrengthPercent, UpdateSourceTrigger=PropertyChanged}" />

            <!-- ── 手动覆盖 ── -->
            <StackPanel Grid.Row="10" Grid.ColumnSpan="3" Margin="0,12,0,8">
                <TextBlock FontWeight="SemiBold"
                           Text="{DynamicResource LOCDsInApex_SettingsOverrides}" />
                <TextBlock Margin="0,4,0,0" Opacity="0.75" TextWrapping="Wrap"
                           Text="{DynamicResource LOCDsInApex_SettingsOverridesHint}" />
            </StackPanel>

            <DataGrid Grid.Row="11" Grid.ColumnSpan="3" MinHeight="180"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" IsReadOnly="True"
                      ItemsSource="{Binding Settings.Profiles}">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="*" Binding="{Binding GameName}"
                                        Header="{DynamicResource LOCDsInApex_SettingsColumnGame}" />
                    <DataGridTextColumn Width="110" Binding="{Binding ActivationDisplayName}"
                                        Header="{DynamicResource LOCDsInApex_SettingsColumnActivation}" />
                    <DataGridTextColumn Width="180" Binding="{Binding RemappingDisplayName}"
                                        Header="{DynamicResource LOCDsInApex_SettingsColumnRemapping}" />
                    <DataGridTextColumn Width="150" Binding="{Binding ApexProfileDisplayName}"
                                        Header="{DynamicResource LOCDsInApex_SettingsColumnApexProfile}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </ScrollViewer>
</UserControl>
