<?xml version="1.0" encoding="utf-8"?>
<!--
  Ds in Apex · Playnite plugin · English (base language)
  ⚠️ 所有键必须全局唯一（Playnite 把所有扩展的字典合进同一资源表），统一用 LOCDsInApex_ 前缀。
  ⚠️ 本文件与 zh_CN.xaml 的键集合、占位符必须逐条对齐 —— 由 build/verify-p9.ps1 的本地化审计强制校验。
  ⚠️ 本文件是「松散文件」随包分发（Playnite 按语言读取），不能被编译进 DLL。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- ── 游戏右键菜单 ── -->
  <sys:String x:Key="LOCDsInApex_MenuActivation">Activation</sys:String>
  <sys:String x:Key="LOCDsInApex_MenuRemapping">Touchpad remapping</sys:String>
  <sys:String x:Key="LOCDsInApex_MenuApexProfile">APEX profile</sys:String>
  <sys:String x:Key="LOCDsInApex_ActivationAuto">Automatic</sys:String>
  <sys:String x:Key="LOCDsInApex_ActivationAutoDetected">Automatic (recognized game)</sys:String>
  <sys:String x:Key="LOCDsInApex_ActivationEnabled">Enabled</sys:String>
  <sys:String x:Key="LOCDsInApex_ActivationDisabled">Disabled</sys:String>
  <sys:String x:Key="LOCDsInApex_RemappingAuto">Automatic</sys:String>
  <sys:String x:Key="LOCDsInApex_RemappingNone">None</sys:String>
  <sys:String x:Key="LOCDsInApex_ApexProfileKeep">Keep current profile</sys:String>
  <sys:String x:Key="LOCDsInApex_ApexProfileSlot">Profile {0}</sys:String>

  <!-- ── 配置档显示名 ── -->
  <sys:String x:Key="LOCDsInApex_ProfileStandard">Standard DualSense</sys:String>
  <sys:String x:Key="LOCDsInApex_ProfileSpiderMan2">Spider-Man 2</sys:String>
  <sys:String x:Key="LOCDsInApex_ProfileMilesMorales">Spider-Man: Miles Morales</sys:String>
  <sys:String x:Key="LOCDsInApex_ProfileGhostOfTsushima">Ghost of Tsushima</sys:String>
  <sys:String x:Key="LOCDsInApex_ProfileWarframe">Warframe (default Xbox layout)</sys:String>
  <sys:String x:Key="LOCDsInApex_ProfileDisabled">Disabled (manual override)</sys:String>

  <!-- ── 设置页 ── -->
  <sys:String x:Key="LOCDsInApex_SettingsIntro">Ds in Apex turns your Flydigi APEX controller into a native PS5 DualSense on PC. This extension starts the bridge when a supported game launches, waits until the virtual DualSense is ready, and cleanly restores the controller when the game exits.</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsInstallation">Installation</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsDetectAutomatically">Detect automatically</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsBrowse">Browse…</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsPathTooltip">Optional path to DsInApex.exe (or its folder) for a portable or custom deployment</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsUpdates">Updates</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsCurrentVersion">Current version:</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsCheckForUpdates">Check for updates</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsAutoCheckUpdates">Check GitHub for updates automatically when Playnite starts</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsOpenReleasePage">Open download page</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsUpdateHint">Portable build: download the ZIP and extract it over the current folder. Nothing is installed silently.</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsAutomaticProfiles">Automatic profiles</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsDetectProfilesAtLaunch">Detect verified profiles automatically when a game starts</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsRumble">Rumble</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsEnableRumble">Enable grip rumble and audio haptics</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsHapticThreshold">Haptic threshold (%)</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsInitTimeout">Initialization timeout (s)</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsGyro">APEX 4 gyroscope</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsGyroHint">Applies to the Flydigi APEX 4 only. 100% is the engine's capture-derived calibration; scale it up or down from there. Restart the bridge (re-enter the game) for changes to take effect.</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsGyroStrength">Overall sensitivity (%)</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsGyroYawStrength">Yaw correction (%)</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsGyroRangeTooltip">Valid range is 25-400; 100 means no extra scaling. Out-of-range values are rejected by the engine and the bridge will not start.</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsOverrides">Manual overrides</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsOverridesHint">The list stays empty while everything is automatic. Right-click a game → Ds in Apex to set activation, touchpad remapping and the onboard APEX profile separately.</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsColumnGame">Game</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsColumnActivation">Activation</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsColumnRemapping">Touchpad remapping</sys:String>
  <sys:String x:Key="LOCDsInApex_SettingsColumnApexProfile">APEX profile</sys:String>

  <!-- ── 状态文本 ── -->
  <sys:String x:Key="LOCDsInApex_StatusNotInstalled">Not found</sys:String>
  <sys:String x:Key="LOCDsInApex_StatusConfiguredManually">DsInApex.exe configured manually</sys:String>
  <sys:String x:Key="LOCDsInApex_StatusDetectedAutomatically">Deployment detected automatically</sys:String>
  <sys:String x:Key="LOCDsInApex_StatusInstallationNotFound">Ds in Apex deployment not found</sys:String>
  <sys:String x:Key="LOCDsInApex_StatusChecking">Checking GitHub for updates…</sys:String>
  <sys:String x:Key="LOCDsInApex_StatusUpdateAvailable">Update available: {0}</sys:String>
  <sys:String x:Key="LOCDsInApex_StatusLatest">You are on the latest version ({0}).</sys:String>
  <sys:String x:Key="LOCDsInApex_StatusError">Error: {0}</sys:String>
  <sys:String x:Key="LOCDsInApex_StatusVersionUnknown">unknown</sys:String>

  <!-- ── 错误与对话框 ── -->
  <sys:String x:Key="LOCDsInApex_DlgTitle">Ds in Apex</sys:String>
  <sys:String x:Key="LOCDsInApex_ErrSessionAlreadyActive">Another Ds in Apex bridge session is already active.</sys:String>
  <sys:String x:Key="LOCDsInApex_ErrExternalSessionActive">Another program (the Ds in Apex app or the official tray) is currently using the bridge.</sys:String>
  <sys:String x:Key="LOCDsInApex_ErrExternalSessionActiveHint">Close that session first, then launch the game again.</sys:String>
  <sys:String x:Key="LOCDsInApex_ErrDeployRootNotFound">Ds in Apex was not found. Deploy the portable package, or point the extension settings to DsInApex.exe.</sys:String>
  <sys:String x:Key="LOCDsInApex_ErrEngineNotFound">The bridge engine (engine\ApexSenseBridge.exe) is missing from the deployment folder.</sys:String>
  <sys:String x:Key="LOCDsInApex_ErrBridgeStartFailed">Could not start the Ds in Apex bridge.</sys:String>
  <sys:String x:Key="LOCDsInApex_DlgUpdateTitle">Ds in Apex — Update</sys:String>
  <sys:String x:Key="LOCDsInApex_DlgUpdateBody">Ds in Apex {0} is available.

This is a portable build: download the ZIP and extract it over the current folder — nothing is installed silently.

Open the download page now?</sys:String>
  <sys:String x:Key="LOCDsInApex_NotifyUpdate">Ds in Apex {0} is available. Click to open the download page.</sys:String>
  <sys:String x:Key="LOCDsInApex_BrowseFilter">Ds in Apex|DsInApex.exe|Executables|*.exe</sys:String>
  <sys:String x:Key="LOCDsInApex_ErrSelectWrongExe">Select DsInApex.exe from the deployment folder.</sys:String>
  <sys:String x:Key="LOCDsInApex_VerifyDeployRootNotFound">Ds in Apex was not found. Deploy it, or select DsInApex.exe in the extension settings.</sys:String>
  <sys:String x:Key="LOCDsInApex_VerifyHapticRange">The haptic threshold must be between 0 and 95.</sys:String>
  <sys:String x:Key="LOCDsInApex_VerifyTimeoutRange">The initialization timeout must be between 5 and 60 seconds.</sys:String>
  <sys:String x:Key="LOCDsInApex_VerifyGyroRange">The gyroscope sensitivity must be between 25 and 400 (100 is the default).</sys:String>

  <!-- ── 更新检查错误 ── -->
  <sys:String x:Key="LOCDsInApex_ErrBadTag">Could not parse the release tag: {0}</sys:String>
  <sys:String x:Key="LOCDsInApex_ErrBothEndpointsUnreachable">Neither update endpoint could be reached (jsDelivr manifest / GitHub releases).</sys:String>

  <!-- ── 桥接会话（IPC 契约相关） ── -->
  <sys:String x:Key="LOCDsInApex_BridgeIpcCollision">IPC event name collision.</sys:String>
  <sys:String x:Key="LOCDsInApex_BridgeProcessNotStarted">The bridge engine process did not start.</sys:String>
  <sys:String x:Key="LOCDsInApex_BridgeExited">The engine exited before reporting ready (code {0}).</sys:String>
  <sys:String x:Key="LOCDsInApex_BridgeInitTimeout">The engine did not finish initializing within {0} s.</sys:String>
  <sys:String x:Key="LOCDsInApex_BridgeIpcIncompatible">The bridge returned an incompatible IPC status block.</sys:String>
  <sys:String x:Key="LOCDsInApex_BridgeInitFailed">Bridge initialization failed (code {0}).</sys:String>

</ResourceDictionary>
